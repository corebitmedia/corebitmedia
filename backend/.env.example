# Server
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://www.corebitmedia.com

# Database (MySQL - from Namecheap cPanel OR Render/Railway managed MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=corebitmedia
DB_USER=corebitmedia_user
DB_PASSWORD=changeme

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI (Anthropic) - used for SEO/AEO/GEO generation features in admin panel
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# File uploads (using local disk by default; swap for S3/R2 later)
UPLOAD_DIR=uploads

# Contact form email notifications (optional). If left blank, submissions
# still save to the database and show up in the admin panel — they just
# won't trigger an email. Any SMTP provider works (Gmail app password,
# SendGrid, Mailgun, your host's own SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Core Bit Media <no-reply@corebitmedia.com>
CONTACT_TO_EMAIL=sales@corebitmedia.com
