# Server
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://www.corebitmedia.com

# Database (MySQL - from Namecheap cPanel OR Render/Railway managed MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=corebitmedia
DB_USER=corebitmedia_user
DB_PASSWORD=changeme

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI (Anthropic) - used for SEO/AEO/GEO generation features in admin panel
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# File uploads (using local disk by default; swap for S3/R2 later)
UPLOAD_DIR=uploads

# Contact form email notifications (optional). If left blank, submissions
# still save to the database and show up in the admin panel — they just
# won't trigger an email. Any SMTP provider works (Gmail app password,
# SendGrid, Mailgun, your host's own SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Core Bit Media <no-reply@corebitmedia.com>
CONTACT_TO_EMAIL=sales@corebitmedia.com

# GA4 self-serve report tool (/ga4-insights/) — visitors connect their own
# GA4 property via Google OAuth, get a shareable report link. Set up a
# Google Cloud OAuth Client (enable the Google Analytics Data + Admin
# APIs) and point its redirect URI at GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.corebitmedia.com/api/ga4/oauth/callback
# 32-byte hex string used to encrypt stored refresh tokens at rest — e.g.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Customer dashboard "Continue with Google" sign-in (separate purpose from
# the GA4-connect flow above — profile/email only, never analytics access).
# Reuses the same GOOGLE_CLIENT_ID/SECRET; add this as a SECOND Authorized
# redirect URI on that same OAuth Client in Google Cloud Console.
GOOGLE_CUSTOMER_OAUTH_REDIRECT_URI=https://www.corebitmedia.com/api/customers/oauth/google/callback
